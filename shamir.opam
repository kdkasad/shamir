# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Shamir secret sharing tool"
authors: ["Kian Kasad <kian@kasad.com>"]
license: "MIT"
homepage: "https://github.com/kdkasad/shamir"
bug-reports: "https://github.com/kdkasad/shamir/issues"
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.23"}
  "ppx_expect" {>= "v0.17" & with-test}
  "ppx_inline_test" {>= "v0.17" & with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/kdkasad/shamir.git"
x-maintenance-intent: ["(latest)"]
